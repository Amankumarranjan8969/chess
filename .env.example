# ==============================================================================
# CHESSMASTER PLATFORM ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to '.env' and customize values for your deployment.
# NEVER commit your actual '.env' file to version control.
# ==============================================================================

# Server Network Configuration
PORT=4000
NODE_ENV=production

# Cryptographic Token Signing Secret
# (Must be at least 32 random characters in production; auto-generated if omitted)
AUTH_SECRET=replace_with_a_secure_random_32_char_secret_key

# Super Admin Initial Credentials
# Configure your own credentials here. The server stores only salted scrypt hashes.
SUPERADMIN_ID=admin@yourdomain.com
SUPERADMIN_PASSWORD=change_this_to_a_strong_password_123

# Additional Allowed Origins for CORS (comma-separated, optional)
# Localhost and LAN private IPs are allowed automatically by default.
ALLOWED_ORIGINS=http://localhost:3000

# Client Configuration (optional override for frontend builds)
# VITE_SERVER_URL=http://localhost:4000
